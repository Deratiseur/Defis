/*

/////////////////////////////////////////////////////////////////////////////////////
//////////////////////   110 - LE TOMBEAU DU GRAND VER + 101   //////////////////////
/////////////////////////////////////////////////////////////////////////////////////
COPY ~Derats_Defis/pxd110/Area~					~override~
COPY ~Derats_Defis/pxd110/Anim/Abishai-red-blue~ ~override~
COPY ~Derats_Defis/pxd110/Anim/Half-dragon_black~ ~override~
COPY ~Derats_Defis/pxd110/Anim/Half-dragon_red~	~override~
COPY_EXISTING ~pxd108sp.cre~		~override/pxd110sp.cre~	WRITE_ASCII 0x514 ~pxd110sp~ #8
COPY_EXISTING ~pxd108sp.spl~		~override/pxd110sp.spl~	WRITE_ASCII 0xae ~pxd110~ #8



COPY ~Derats_Defis/pxd110-101/Area~				~override~
COPY ~Derats_Defis/pxd110/items/pxdbatoc.itm~ 	~override~	SAY NAME2 @251	SAY DESC @252

/////////////////////////////////////////////////////////////////////////////////////
///////////////////////////////   100 - LA FOURNAISE   //////////////////////////////
/////////////////////////////////////////////////////////////////////////////////////
COPY ~Derats_Defis/pxd100/Area~					~override~
COPY_EXISTING ~pxd108sp.cre~		~override/pxd100sp.cre~	WRITE_ASCII 0x514 ~pxd100sp~ #8
COPY_EXISTING ~pxd108sp.spl~		~override/pxd100sp.spl~	WRITE_ASCII 0xae ~pxd100~ #8
COPY ~Derats_Defis/pxd100/pxd1001.spl~			~override~	WRITE_SHORT 0x98 ~%pxdtout%~

/////////////////////////////////////////////////////////////////////////////////////
///////////////////////////   201 - LA SALLE DE TORTURE   ///////////////////////////
/////////////////////////////////////////////////////////////////////////////////////
COPY ~Derats_Defis/pxd201/Area~					~override~
COPY_EXISTING ~pxd108sp.cre~		~override/pxd201sp.cre~	WRITE_ASCII 0x514 ~pxd201sp~ #8
COPY_EXISTING ~pxd108sp.spl~		~override/pxd201sp.spl~	WRITE_ASCII 0xae ~pxd201~ #8

/////////////////////////////////////////////////////////////////////////////////////
//////////////////////////////   708 - LA FORGE + 501   /////////////////////////////
/////////////////////////////////////////////////////////////////////////////////////
COPY ~Derats_Defis/pxd708/Area~					~override~
COPY ~Derats_Defis/pxd708/Anim/Iwd_Iron_Golem~	~override~
COPY_EXISTING ~pxd108sp.cre~		~override/pxd708sp.cre~	WRITE_ASCII 0x514 ~pxd708sp~ #8
COPY_EXISTING ~pxd108sp.spl~		~override/pxd708sp.spl~	WRITE_ASCII 0xae ~pxd708~ #8


COPY ~Derats_Defis/pxd708-501/Area~				~override~
COPY ~Derats_Defis/pxd708-501/pxd501b.cre~		~override~	SAY NAME1 @70801	SAY NAME2 @70801
COPY_EXISTING ~pxd108sp.cre~		~override/pxd501sp.cre~	WRITE_ASCII 0x514 ~pxd501sp~ #8
COPY_EXISTING ~pxd108sp.spl~		~override/pxd501sp.spl~	WRITE_ASCII 0xae ~pxd501~ #8

/////////////////////////////////////////////////////////////////////////////////////
////////////////////////////   204 - POCHE DE NORMALITÉ   ///////////////////////////
/////////////////////////////////////////////////////////////////////////////////////

COPY ~Derats_Defis/pxd204/Area~					~override~
COPY_EXISTING ~pxd108sp.cre~		~override/pxd204sp.cre~	WRITE_ASCII 0x514 ~pxd204sp~ #8
COPY_EXISTING ~pxd108sp.spl~		~override/pxd204sp.spl~	WRITE_ASCII 0xae ~pxd204~ #8

/////////////////////////////////////////////////////////////////////////////////////
/////////////////////////////   105 - LA BIBLIOTHÈQUE   /////////////////////////////
/////////////////////////////////////////////////////////////////////////////////////

COPY ~Derats_Defis/pxd105/Area~					~override~
COPY ~Derats_Defis/pxd105/Copy~					~override~

////Nouvelle animation : Tarasque
LAF FIND_FREE_ANIM_SLOT INT_VAR slotMin = 0xE000 slotMax = 0xefff RET slot END
ACTION_IF (slot <= 0) BEGIN
  FAIL ~No free creature animation slot found.~
END

LAF TO_HEX_NUMBER INT_VAR value = slot minDigits = 4 RET hexNumber END
APPEND ~animate.ids~ ~0x%hexNumber% GW_Tarasque~ UNLESS ~GW_Tarasque~
CLEAR_IDS_MAP

COPY ~Derats_Defis/pxd105/xdr1.ini~ ~override/%hexNumber%.ini~
ACTION_BASH_FOR ~Derats_Defis/pxd105/Anim/Tarasque~ ~^.+\.bam$~ BEGIN
  COPY ~%BASH_FOR_FILESPEC%~ ~override~
END

////items
COPY ~Derats_Defis/pxd105/items/pxdnegac.itm~	~override~	SAY NAME2 @235	SAY DESC @236
COPY_EXISTING ~spwi403d.eff~		~override/pxdnegac.eff~	WRITE_ASCII 0x30 ~pxdnegac~ #8

*/

PRINT  @119
SILENT
COMPILE ~Derats_Defis/Scripts~
COMPILE ~Derats_Defis/Temp~
COMPILE ~Derats_Defis/Dialogs~
VERBOSE
