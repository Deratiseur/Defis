    RESPONSE #100
        SpellRES("pxdaffli",NearestEnemyOf(Myself)) //Affliction
        SetGlobalTimer("casting","LOCALS",ONE_ROUND)
END

IF
	!GlobalTimerNotExpired("casting","LOCALS")
	CheckStatLT(Myself,90,SPELLFAILUREMAGE)
	!CheckStatGT(Myself,0,CLERIC_INSECT_PLAGUE)
	See(FourthNearestEnemyOf(Myself))
	HaveSpellRES("pxdproja")
THEN
	RESPONSE #100
		SpellRES("pxdproja",NearestEnemyOf(Myself))//Projectile Arc-en-ciel
