        SpellRES("pxdproja",Nearest([PC]))
        SetGlobalTimer("casting","LOCALS",ONE_ROUND)
END

IF
    !GlobalTimerNotExpired("casting","LOCALS")
    CheckStatLT(Myself,90,SPELLFAILUREMAGE)
    !CheckStatGT(Myself,0,CLERIC_INSECT_PLAGUE)
    NumCreature([PC],2)
    RandomNum(2,2)
    HaveSpellRES("pxdproja")
THEN
    RESPONSE #100
        SpellRES("pxdproja",SecondNearest([PC]))
        SetGlobalTimer("casting","LOCALS",ONE_ROUND)
END

IF
    !GlobalTimerNotExpired("casting","LOCALS")
    CheckStatLT(Myself,90,SPELLFAILUREMAGE)
    !CheckStatGT(Myself,0,CLERIC_INSECT_PLAGUE)
    NumCreature([PC],1)
    HaveSpellRES("pxdproja")
THEN
    RESPONSE #100
        SpellRES("pxdproja",Nearest([PC]))
        SetGlobalTimer("casting","LOCALS",ONE_ROUND)
END

IF
	!GlobalTimerNotExpired("casting","LOCALS")
	CheckStatLT(Myself,90,SPELLFAILUREMAGE)
	!CheckStatGT(Myself,0,CLERIC_INSECT_PLAGUE)
    See(NearestEnemyOf(Myself))
    HaveSpellRES("pxdorbeg")
THEN
    RESPONSE #100
        SpellRES("pxdorbeg",NearestEnemyOf(Myself)) 
        SetGlobalTimer("casting","LOCALS",ONE_ROUND)
END

IF
    See(NearestEnemyOf(Myself))
    OR(3)
        !HaveAnySpells()
        CheckStatGT(Myself,99,SPELLFAILUREMAGE)
        CheckStatGT(Myself,0,CLERIC_INSECT_PLAGUE)
THEN
    RESPONSE #100
        AttackOneRound(NearestEnemyOf(Myself))
END