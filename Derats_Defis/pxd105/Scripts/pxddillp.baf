IF
    CheckStatGT(Myself,0,AURACLEANSING)
    GlobalTimerNotExpired("casting","LOCALS")
THEN
    RESPONSE #100
        SetGlobalTimer("casting","LOCALS",0)
END

IF
    StateCheck(Myself,STATE_SILENCED)
    !GlobalTimerNotExpired("casting","LOCALS")
    HaveSpell(WIZARD_VOCALIZE)
THEN
    RESPONSE #100
        Spell(Myself,WIZARD_VOCALIZE)
        SetGlobalTimer("casting","LOCALS",ONE_ROUND)
END

IF 	!GlobalTimerNotExpired("casting","LOCALS")
	CheckStatLT(Myself,90,SPELLFAILUREMAGE)
	!CheckStatGT(Myself,0,CLERIC_INSECT_PLAGUE)
		HaveSpellRES("pxl2prep")
        !HaveSpellRES("PXL2PNOV")
        !HaveSpellRES("PXDNUATU")
        !HaveSpellRES("pxdproja")  
THEN
    RESPONSE #100
        SpellRES("pxl2prep",Myself)
        SetGlobalTimer("casting","LOCALS",ONE_ROUND)
END

IF
	!GlobalTimerNotExpired("casting","LOCALS")
	CheckStatLT(Myself,90,SPELLFAILUREMAGE)
	!CheckStatGT(Myself,0,CLERIC_INSECT_PLAGUE)
	GlobalGT("px105dilp","LOCALS",6)
    See(NearestEnemyOf(Myself))
	HaveSpell(WIZARD_IMPROVED_ALACRITY) 
	CheckStat(Myself,0,AURACLEANSING)
THEN
    RESPONSE #100
		Spell(Myself,WIZARD_IMPROVED_ALACRITY) 
		SetGlobalTimer("casting","LOCALS",ONE_ROUND)
END

