IF
	Global("pxdillbook","GLOBAL",0)
	PartyHasItem("pxl2dill")
	See(Player1)
THEN
	RESPONSE #100
		SetGlobal("pxdillbook","GLOBAL",3)
		StartDialogueNoSet(Player1)
END

IF
	Global("pxdillbook","GLOBAL",2)
THEN
	RESPONSE #100
		ChangeEnemyAlly(Myself,NEUTRAL)
		ForceSpell(Myself,DRYAD_TELEPORT) 
		Wait(1)
		DestroySelf()
END

IF
	Global("pxdtelim","GLOBAL",2)
	!Exists("pxdtelim")
	!Exists("pxdgrod")
THEN
	RESPONSE #100
		ForceSpell(Myself,DRYAD_TELEPORT)
		Wait(1)
		DestroySelf()
END

IF
    CheckStatGT(Myself,0,AURACLEANSING)
    GlobalTimerNotExpired("casting","LOCALS")
THEN
    RESPONSE #100
        SetGlobalTimer("casting","LOCALS",0)
END

IF
    StateCheck(Myself,STATE_SILENCED)
    !GlobalTimerNotExpired("casting","LOCALS")
    HaveSpell(WIZARD_VOCALIZE)
THEN
    RESPONSE #100
        Spell(Myself,WIZARD_VOCALIZE)
        SetGlobalTimer("casting","LOCALS",ONE_ROUND)
END

IF 	!GlobalTimerNotExpired("casting","LOCALS")
	CheckStatLT(Myself,90,SPELLFAILUREMAGE)
	!CheckStatGT(Myself,0,CLERIC_INSECT_PLAGUE)
		HaveSpellRES("pxl2prep")
        !HaveSpellRES("PXL2PNOV")
        !HaveSpellRES("PXDNUATU")
        !HaveSpellRES("pxdproja")  
THEN
    RESPONSE #100
        SpellRES("pxl2prep",Myself)
        SetGlobalTimer("casting","LOCALS",ONE_ROUND)
END

IF
	!GlobalTimerNotExpired("casting","LOCALS")
	CheckStatLT(Myself,90,SPELLFAILUREMAGE)
	!CheckStatGT(Myself,0,CLERIC_INSECT_PLAGUE)
	GlobalGT("px105dilp","LOCALS",5)
    See(NearestEnemyOf(Myself))
	HaveSpell(WIZARD_IMPROVED_ALACRITY) 
	CheckStat(Myself,0,AURACLEANSING)
THEN
    RESPONSE #100
		Spell(Myself,WIZARD_IMPROVED_ALACRITY) 
		SetGlobalTimer("casting","LOCALS",ONE_ROUND)
END

IF 
	HPPercentLT(Myself,33)
	See(NearestEnemyOf(Myself))
	HasItem("PXPASOIN",Myself)
THEN
	RESPONSE #100
		DisplayStringHead(Myself,@1052199)
		UseItem("PXPASOIN",Myself)
END

// Protection de secours lorsque l'Image réfléchie majeure n'est plus disponible.
IF
	AttackedBy([ANYONE],DEFAULT)
    HPPercentLT(Myself,60)
    !HaveSpellRES("pxdimagr")
    HasItem("PXL2DPRT",Myself)
    See(NearestEnemyOf(Myself))
THEN
    RESPONSE #100
        DisplayStringHead(Myself,@1052199)
        UseItem("PXL2DPRT",Myself) //Potion de protection Totale
END

IF
    Global("pxdtelim","GLOBAL",2)
    Global("px105dilp","LOCALS",0)
	!GlobalTimerNotExpired("casting","LOCALS")
    See(NearestEnemyOf(Myself))
THEN
    RESPONSE #100
		DisplayStringHead(Myself,@1052199)
		UseItem("PXL2DPUI",Myself) //Potion de puissance extrême // dommages +150%
        StartTimer(60,60)
        SetGlobal("px105dilp","LOCALS",1)
		SetGlobalTimer("casting","LOCALS",ONE_ROUND)
END

