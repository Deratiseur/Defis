IF
	Global("pxtelimcounted","LOCALS",0)
	Die()
		SpellCastOnMeRES("PXL2PNV1",[ANYONE])
THEN
	RESPONSE #100
		SetGlobal("pxtelimcounted","LOCALS",1)
		SetGlobal("pxgrodDill","GLOBAL",1)
		IncrementGlobal("telimrep","GLOBAL",1)
END

IF
	AttackedBy([ANYONE],DEFAULT)
THEN
    RESPONSE #100
        AttackReevaluate(LastAttackerOf(Myself),30)
END

IF
    Global("pxdtelim","GLOBAL",2)
	See(NearestEnemyOfType([0.0.0.MAGE_ALL]))
THEN
    RESPONSE #100
        AttackReevaluate(LastSeenBy(Myself),30)
END

IF
	Global("pxdtelim","GLOBAL",2)
    See(NearestEnemyOfType([0.0.0.CLERIC_ALL]))
THEN
    RESPONSE #100
        AttackReevaluate(LastSeenBy(Myself),30)
END

