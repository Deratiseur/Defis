IF
	OR(2)
	SpellCastOnMe([ANYONE],CLERIC_REMOVE_CURSE)
	SpellCastOnMe([ANYONE],WIZARD_REMOVE_CURSE)
THEN
    RESPONSE #100
		DisplayStringHead(Myself,@10512)
        Kill(Myself)
        AddexperienceParty(8000)
END

IF
	Global("pxtelimcounted","LOCALS",0)
	Die()
	SpellCastOnMeRES("PXL2PNV1",[ANYONE])
THEN
	RESPONSE #100
		SetGlobal("pxtelimcounted","LOCALS",1)
		IncrementGlobal("telimrep","GLOBAL",1)
END
