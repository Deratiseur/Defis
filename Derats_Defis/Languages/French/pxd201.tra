@20101 = ~Nuage de frénésie bestiale~
@20102 = ~Liptzitn, seigneur de la 618ème~
@20103 = ~Vous remarquez que sur cette horloge de pierre les aiguilles sont désolidarisées de l'ensemble. Peut-être qu'en les forçant vous pourriez les repositionner. Pour l'instant elles indiquent 9h00. Vers quelle heure voudriez-vous repositionner les aiguilles ?~
@2010850 = ~8h50.~
@2010851 = ~8h51.~
@2010852 = ~8h52.~
@2010853 = ~8h53.~
@2010854 = ~8h54.~
@2010855 = ~8h55.~
@2010856 = ~8h56.~
@2010857 = ~8h57.~
@2010858 = ~8h58.~
@2010859 = ~8h59.~
@2010901 = ~9h01.~
@2010902 = ~9h02.~
@2010903 = ~9h03.~
@2010904 = ~9h04.~
@2010905 = ~9h05.~
@2010906 = ~9h06.~
@2010907 = ~9h07.~
@2010908 = ~9h08.~
@2010909 = ~9h09.~
@2010910 = ~9h10.~
@2010912 = ~Forcer jusqu'à 9h12.~ //nécessite 21 de force
@20109129 = ~Vous n'y arrivez pas, il vous faudrait plus de force.~
@20104 = ~Ne pas toucher aux aiguilles.~
@20105 = ~Vous déplacez les aiguilles, et une fois qu'elles sont calées là où vous le vouliez, vous pouvez entendre un petit "clic". Vous ne savez pas à quoi il correspond. Pour vérifier vous tentez de déplacer les aiguilles, mais elles refusent de bouger, cette fois.~
@20106 = ~Vous remarquez que sur cette horloge de pierre les aiguilles sont désolidarisées de l'ensemble. Peut-être qu'en les forçant vous pourriez les repositionner. Pour l'instant elles indiquent 1h00. Vers quelle heure voudriez-vous repositionner les aiguilles ?~
@2010050 = ~0h50.~
@2010051 = ~0h51.~
@2010052 = ~0h52.~
@2010053 = ~0h53.~
@2010054 = ~0h54.~
