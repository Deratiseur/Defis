IF
	Die()
THEN
	RESPONSE #100
		ReallyForceSpellDead(Myself,ILLUSION_DEATH)
		Wait(1)
		DestroySelf()
END

IF
	OR(6)
		See(Player1)
		See(Player2)
		See(Player3)
		See(Player4)
		See(Player5)
		See(Player6)
	Global("px201talk","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobal("px201talk","LOCALS",1)
		StartDialogueNoSet(LastSeenBy(Myself))
END

