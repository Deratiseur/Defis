////Boss
DEFINE_PATCH_FUNCTION Anti160 BEGIN
LPF Anticre END
WRITE_ASCII 0x248 ~~ #8
WRITE_ASCII 0x268 ~WDASIGHT~ #8
LPF ADD_CRE_EFFECT INT_VAR opcode = 206 target = 1 timing = 9 STR_VAR resource = Pxd1601 END
LPF ADD_CRE_EFFECT INT_VAR opcode = 206 target = 1 timing = 9 STR_VAR resource = spwi001 END
LPF ADD_CRE_EFFECT INT_VAR opcode = 206 target = 1 timing = 9 STR_VAR resource = spwi004 END
END

COPY ~Derats_Defis/pxd160/Cres/pxd160b.cre~		~override~	SAY NAME1 @16001	SAY NAME2 @16001	LPF Anti160 END
COPY ~Derats_Defis/pxd160/Cres/pxd160b2.cre~	~override~	SAY NAME1 @16002	SAY NAME2 @16002	LPF Anti160 END

