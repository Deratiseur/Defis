COPY_EXISTING ~pxd108sp.spl~		~override/pxd160sp.spl~	WRITE_ASCII 0xae ~pxd160~ #8
COPY ~Derats_Defis/pxd160/pxd1601.spl~			~override~	WRITE_SHORT 0x98 ~%pxdtout%~

COPY ~Derats_Defis/pxd160/pxd160.are~			~override~	SAY 0x6404 @16007	SAY 0x64c8 @16008	SAY 0x658c @16003	SAY 0x6650 @16003
SAY 0x6714 @16003	SAY 0x67d8 @16003	SAY 0x689c @16003	SAY 0x6960 @16003	SAY 0x6a24 @16003	SAY 0x6960 @16003	SAY 0x6ae8 @16003
SAY 0x6bac @16004	SAY 0x6c70 @16005	SAY 0x6d34 @16009	SAY 0x6df8 @16012	SAY 0x6ebc @16013	SAY 0x6f80 @16010	SAY 0x7044 @16006
SAY 0x7108 @16011	SAY 0x71cc @16011	SAY 0x7290 @16011	SAY 0x7354 @16011	SAY 0x7418 @16016	SAY 0x74dc @16011	SAY 0x75a0 @16011
ACTION_IF FILE_EXISTS_IN_GAME ~pxl2hexa.itm~ THEN BEGIN
COPY_EXISTING ~pxd160.are~						~override~
LPF ADD_AREA_ITEM INT_VAR container_to_add_to = 4 STR_VAR item_to_add = ~PXDINT1~ END 
LPF ADD_AREA_ITEM INT_VAR container_to_add_to = 10 STR_VAR item_to_add = ~PXDINT2~ END
BUT_ONLY
END


