DEFINE_PATCH_FUNCTION Antiall BEGIN
LPF Anti108 END
LPF Anti160 END
LPF Anti610 END
LPF Anti208 END
LPF Anti190 END
LPF Anti180 END
LPF Anti100 END
LPF Anti708 END
LPF Anti110 END
