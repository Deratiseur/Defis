////Boss
DEFINE_PATCH_FUNCTION Anti108 BEGIN
LPF Anticre END
WRITE_ASCII 0x248 ~~ #8
WRITE_ASCII 0x268 ~WDASIGHT~ #8
LPF ADD_CRE_EFFECT INT_VAR opcode = 206 target = 1 timing = 9 STR_VAR resource = spwi004 END
LPF ADD_CRE_EFFECT INT_VAR opcode = 206 target = 1 timing = 9 STR_VAR resource = spwi016 END
LPF ADD_CRE_EFFECT INT_VAR opcode = 206 target = 1 timing = 9 STR_VAR resource = pxd108b1 END
END

COPY ~Derats_Defis/pxd108/Cres/pxd108b.cre~		~override~	SAY NAME1 @10801	SAY NAME2 @10801	LPF Anti108 END
COPY_EXISTING ~Planetar.itm~		~override/pxd108b.itm~
LPF ADD_ITEM_EFFECT INT_VAR opcode = 146 type = 1 target = 2  probability1 = 10 parameter2 = 1 timing = 1 resist_dispel = 2 STR_VAR resource = SPWI409 END

