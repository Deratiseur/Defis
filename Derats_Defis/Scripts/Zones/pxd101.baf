IF
	OnCreation()
	Global("px101start","PXD101",0)
THEN
	RESPONSE #100
		Explore()
		StartTimer(6,30)
		SetGlobal("px101start","PXD101",1)
		ActionOverride("pxd101b",StartDialogueNoSet([PC]))
END

IF
	OnCreation()
	Global("px101start","PXD101",1)
THEN
	RESPONSE #100
		StartTimer(6,30)
END

IF
   TimerExpired(6)
   RandomNum(10,1)
THEN
    RESPONSE #100
        ReallyForceSpellPointRES("Pxd1101",[865.801])
		CreateCreature("pxd101sp",[650.840],S)
        StartTimer(6,18)
    RESPONSE #100
        ReallyForceSpellPointRES("Pxd1101",[865.801])
		CreateCreature("pxd101sp",[789.922],S)
        StartTimer(6,24)
	RESPONSE #100
        ReallyForceSpellPointRES("Pxd1101",[865.801])
		CreateCreature("pxd101sp",[1008.915],S)
        StartTimer(6,30)
    RESPONSE #100
        ReallyForceSpellPointRES("Pxd1101",[865.801])
		CreateCreature("pxd101sp",[828.823],S)
        StartTimer(6,36)
    RESPONSE #100
        ReallyForceSpellPointRES("Pxd1101",[865.801])
		CreateCreature("pxd101sp",[854.722],S)
        StartTimer(6,42)
    RESPONSE #100
        ReallyForceSpellPointRES("Pxd1101",[865.801])
		CreateCreature("pxd101sp",[1101.834],S)
        StartTimer(6,48)		
END

