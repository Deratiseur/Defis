IF
	Global("pxd101dead","GLOBAL",1)
THEN
	RESPONSE #100
		Wait(8)
		CreateVisualEffect("pxl2xspv",[796.734])
		Wait(2)
		CreateCreature("pxdnerul",[796.734],S)
		SetGlobal("pxd101dead","GLOBAL",2)
END

