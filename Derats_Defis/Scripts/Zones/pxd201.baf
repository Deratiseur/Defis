IF
	OnCreation()
	Global("pxdport","PXD201",0)
THEN
	RESPONSE #100
		CreateCreature("pxd201ng",[741.1185],S)
		CreateCreature("pxd201pt",[468.1497],S)
		StartTimer(201,12)
		SetGlobal("pxdport","PXD201",1)
END

