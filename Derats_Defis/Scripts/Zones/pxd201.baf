IF
	OnCreation()
	Global("pxdport","PXD201",1)
	Global("pxdsecret2","PXD201",1)
	Global("px290wn","GLOBAL",0)
THEN
	RESPONSE #100
		StartTimer(201,2)
		CreateVisualEffect("pxd201sv",[3456.411])
		TriggerActivation("secret2",TRUE)
END

