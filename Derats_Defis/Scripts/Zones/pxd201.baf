IF
	Global("pxdhour1","GLOBAL",2)
	Global("pxdhour2","GLOBAL",2)
	Global("pxdhour3","GLOBAL",2)
	Global("pxdsecret2","PXD201",0)
THEN
	RESPONSE #100
		CreateVisualEffect("pxd201sv",[3456.411])
		SetGlobal("pxdsecret2","PXD201",1)
		TriggerActivation(" secret2",TRUE)
		AddMapNote([3455.347],@20116)
END

