		SetGlobalTimer("casting","LOCALS",ONE_ROUND)
	RESPONSE #100
		ReallyForceSpell(NearestEnemyOf(Myself),WIZARD_DRAGONS_BREATH)  // SPWI922.SPL (Souffle de dragon)
		IncrementGlobal("nerullw9","LOCALS",1)
		SetGlobalTimer("casting","LOCALS",ONE_ROUND)
