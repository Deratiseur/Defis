	GlobalLT("nerullw7","LOCALS",7)
	!GlobalTimerNotExpired("casting","LOCALS")
	See(NearestEnemyOf(Myself))
THEN
	RESPONSE #100
		ReallyForceSpell(NearestEnemyOf(Myself),WIZARD_DELAYED_BLAST_FIREBALL)  // SPWI712.SPL (Boule de feu à retardement)
