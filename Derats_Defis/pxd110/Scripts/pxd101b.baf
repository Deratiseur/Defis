IF
	HPPercentLT(Myself,40)
	Global("pxd101devin","LOCALS",0)
	!HaveSpell(CLERIC_HEAL)
THEN
	RESPONSE #100
		ReallyForceSpell(Myself,CLERIC_SANCTUARY)
		DisplayStringHead(Myself,111655)
		ReallyForceSpell(Myself,HOLY_LIGHT_FROM_ABOVE)
		ReallyForceSpellPointRES("px101bn",[601.751])
		ReallyForceSpellPointRES("px101be",[565.924])
		ReallyForceSpellPointRES("px101bb",[1086.928])
		ReallyForceSpellPointRES("px101bp",[693.922])
		ReallyForceSpellPointRES("px101bv",[884.937]) 
		ReallyForceSpellPointRES("px101bg",[808.776])
		ReallyForceSpellPointRES("px101bm",[1018.779])
		ReallyForceSpellPointRES("px101ba",[584.938])
		DestroyItem("imoenhp1")
		ReallyForceSpellRES("pxd101b1",Myself)
		SetGlobal("pxd101tome","LOCALS",0)
		SetGlobal("pxd101skin","LOCALS",0)
		SetGlobal("pxd101devin","LOCALS",1)
END

IF
	Global("pxd101devin","LOCALS",1)
	HaveSpell(CLERIC_FINGER_OF_DEATH)
	See(NearestEnemyOf(Myself))
	!CheckStatGT(LastSeenBy(Myself),0,DEATH_WARD)
THEN
	RESPONSE #100	
	Spell(LastSeenBy(Myself),CLERIC_FINGER_OF_DEATH)
END	

