IF
	Die()
THEN
	RESPONSE #100
		SetGlobal("pxd101dead","GLOBAL",1)
END

IF
	Global("pxd101b","LOCALS",1)
THEN
	RESPONSE #100
		ApplySpell(Myself,CLERIC_MAGIC_RESISTANCE)
		ApplySpell(Myself,CLERIC_FREE_ACTION)
		ApplySpell(Myself,CLERIC_REGENERATE)
		SetGlobal("pxd101b","LOCALS",2)
END

IF
	Global("pxd101skin","LOCALS",0)
THEN
	RESPONSE #100
		DisplayStringHead(Myself,@11025)
		ApplySpell(Myself,CLERIC_IRONSKIN)
		SetGlobal("pxd101skin","LOCALS",1)
END

IF
	HPPercentLT(Myself,40)
	HaveSpell(CLERIC_HEAL)
THEN
	RESPONSE #100
		Spell(Myself,CLERIC_HEAL)
END
		
IF
	See(NearestEnemyOf(Myself))
	HaveSpell(NPC_BLADE_BARRIER)
	!GlobalTimerNotExpired("Barrier","LOCALS")
THEN
	RESPONSE #100
		Spell(Myself,NPC_BLADE_BARRIER)
		SetGlobalTimer("Barrier","LOCALS",TEN_ROUNDS)
		Continue()
END

