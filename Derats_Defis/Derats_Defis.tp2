BEGIN @12 SUBCOMPONENT @11	DESIGNATED 111	LABEL Px_Defi_multi_x2
REQUIRE_PREDICATE (MOD_IS_INSTALLED ~Setup-Derats_Defis.tp2~ ~1161~ OR MOD_IS_INSTALLED ~Setup-Derats_Defis.tp2~ ~1162~	OR MOD_IS_INSTALLED ~Setup-Derats_Defis.tp2~ ~1163~) @15
COPY_EXISTING ~pxd108sp.spl~ ~override~
			  ~pxd404sp.spl~ ~override~
			  ~pxd160sp.spl~ ~override~
			  ~pxd150sp.spl~ ~override~
			  ~pxd610sp.spl~ ~override~
			  ~pxd208sp.spl~ ~override~
			  ~pxd190sp.spl~ ~override~
			  ~pxd180sp.spl~ ~override~ WRITE_BYTE 0x9e 2
			  //+ Poche de normalité apparition des MVS 2x+ vite
			  //+ Final 2x + de gardiens
BEGIN @13 SUBCOMPONENT @11	DESIGNATED 112	LABEL Px_Defi_multi_x3
REQUIRE_PREDICATE (MOD_IS_INSTALLED ~Setup-Derats_Defis.tp2~ ~1161~ OR MOD_IS_INSTALLED ~Setup-Derats_Defis.tp2~ ~1162~	OR MOD_IS_INSTALLED ~Setup-Derats_Defis.tp2~ ~1163~) @15
COPY_EXISTING ~pxd108sp.spl~ ~override~
			  ~pxd404sp.spl~ ~override~
			  ~pxd160sp.spl~ ~override~
			  ~pxd150sp.spl~ ~override~
			  ~pxd208sp.spl~ ~override~
			  ~pxd190sp.spl~ ~override~
			  ~pxd180sp.spl~ ~override~ WRITE_BYTE 0x9e 3
			  //+ Poche de normalité apparition des MVS 3x+ vite
			  //+ Final 3x + de gardiens
BEGIN @14 SUBCOMPONENT @11	DESIGNATED 113	LABEL Px_Defi_multi_x4
REQUIRE_PREDICATE (MOD_IS_INSTALLED ~Setup-Derats_Defis.tp2~ ~1161~ OR MOD_IS_INSTALLED ~Setup-Derats_Defis.tp2~ ~1162~	OR MOD_IS_INSTALLED ~Setup-Derats_Defis.tp2~ ~1163~) @15
COPY_EXISTING ~pxd108sp.spl~ ~override~
			  ~pxd404sp.spl~ ~override~
			  ~pxd150sp.spl~ ~override~
			  ~pxd610sp.spl~ ~override~
			  ~pxd208sp.spl~ ~override~
			  ~pxd190sp.spl~ ~override~
			  ~pxd180sp.spl~ ~override~ WRITE_BYTE 0x9e 4
			  //+ Poche de normalité apparition des MVS 4x+ vite
			  //+ Final 4x + de gardiens

			  
/* //pas en Wip 2 à cause de Nécropole manquante.
BEGIN @17	DESIGNATED 17	LABEL Px_Defi_difficulty
REQUIRE_PREDICATE (MOD_IS_INSTALLED ~Setup-Derats_Defis.tp2~ ~1161~ OR MOD_IS_INSTALLED ~Setup-Derats_Defis.tp2~ ~1162~	OR MOD_IS_INSTALLED ~Setup-Derats_Defis.tp2~ ~1163~) @15

//PXD108 La décharge -> des rats pestiférés se promènent dans la zone et qui s'en approche risque de chopper la peste calimshane

//PXD160 La nécropole silencieuse
//Pas trouvé

//PXD610 Le Jardin végétal -> tous les vers sont infectés
COPY_EXISTING_REGEXP ~^px1083\([0-9][0-9]\)\.cre$~ ~override/px6107\1.cre~	WRITE_ASCII 0x260 ~pxdmouch~  #8
LPF ADD_CRE_EFFECT INT_VAR opcode = 146 parameter2 = 1 timing = 9 target = 1 STR_VAR resource = pxdmouch
LPF ADD_CRE_EFFECT INT_VAR opcode = 206 target = 1 timing = 9 STR_VAR resource = pxdmoucy END
COPY_EXISTING ~px610708.cre~						~override~	 WRITE_ASCII 0x260 ~~	WRITE_ASCII 0x248 ~px610708~ 
COPY ~Derats_Defis/Difficulty/Scripts/px610708.baf~ ~Derats_Defis/Difficulty/Scripts/px610710.baf~ REPLACE_TEXTUALLY ~pxdmephy~ ~pxdaveuy~
COPY_EXISTING ~px610710.cre~						~override~	WRITE_ASCII 0x260 ~~	WRITE_ASCII 0x248 ~px610710~
COPY ~Derats_Defis/Difficulty/Scripts/px610708.baf~ ~Derats_Defis/Difficulty/Scripts/px610711.baf~ REPLACE_TEXTUALLY ~pxdmephy~ ~pxdmalhy~
COPY_EXISTING ~px610711.cre~						~override~	WRITE_ASCII 0x260 ~~	WRITE_ASCII 0x248 ~px610711~
COPY ~Derats_Defis/Difficulty/Scripts/px610708.baf~ ~Derats_Defis/Difficulty/Scripts/px610738.baf~ REPLACE_TEXTUALLY ~pxdmephy~ ~px108138~
COPY_EXISTING ~px610738.cre~						~override~	WRITE_ASCII 0x260 ~~	WRITE_ASCII 0x248 ~px610738~
COPY_EXISTING ~px610739.cre~						~override~	WRITE_ASCII 0x260 ~~	WRITE_ASCII 0x248 ~px610739~
COPY_EXISTING ~px610743.cre~						~override~	WRITE_ASCII 0x260 ~~	WRITE_ASCII 0x248 ~px610743~
COPY_EXISTING ~sppr717.spl~			~override/pxdmoucy.spl~

